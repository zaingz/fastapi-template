# Application
APP_NAME="My API"
ENVIRONMENT=local            # local | staging | production
DEBUG=true                   # exposes /docs, /redoc, /openapi.json

# Logging
LOG_LEVEL=INFO
LOG_JSON=false               # true in production for structured logs

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_HEADERS=["Authorization","Content-Type","X-Request-ID"]

# Trusted hosts (Host-header allow-list). Empty = allow any (dev). Set explicit hostnames
# in production so spoofed Host headers 400 instead of routing.
ALLOWED_HOSTS=[]

# Trust boundary — reject request bodies larger than this many bytes with 413.
MAX_REQUEST_BYTES=1048576    # 1 MiB

# Security response headers
SECURITY_HEADERS_ENABLED=true
CSP_FRAME_ANCESTORS='none'
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=geolocation=(), microphone=(), camera=()
HSTS_ENABLED=false           # set true behind HTTPS in production
HSTS_MAX_AGE=31536000

# Security — REQUIRED in production: override this or the app refuses to boot.
SECRET_KEY=replace-this-with-a-secure-random-string-of-32-chars

# Shared outbound HTTP client (lifespan-managed). Explicit per-phase timeouts (seconds)
# and pool limits so a hung upstream can't pin a worker.
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
HTTP_WRITE_TIMEOUT=10
HTTP_POOL_TIMEOUT=5
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20

# Rate limiting (in-process fixed window). Disabled by default; the local limiter is
# per-process only — use a shared backend (Redis) for multi-instance correctness.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# AI — defaults to the `echo` provider (no API key, no network required)
AI_PROVIDER=echo
AI_MODEL=echo-1
AI_PROMPT_VERSION=v1
AI_REQUEST_TIMEOUT=30        # per provider call/token, seconds
# OPENAI_API_KEY=sk-...      # only needed if you wire a real provider (see docs/architecture.md)

# AI response cache (in-process exact-match)
CACHE_TTL=300
CACHE_MAX_SIZE=1024

# Server bind is owned by the ASGI server, not app config:
#   local dev  -> `make dev` (uvicorn --host 0.0.0.0 --port 8000)
#   container  -> gunicorn.conf.py reads $PORT (default 8000) and $WEB_CONCURRENCY (workers)

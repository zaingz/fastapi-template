# Application
APP_NAME="My API"
ENVIRONMENT=local            # local | staging | production
DEBUG=true                   # exposes /docs, /redoc, /openapi.json

# Logging
LOG_LEVEL=INFO
LOG_JSON=false               # true in production for structured logs

# CORS
CORS_ORIGINS=["http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=false

# Security — REQUIRED in production: override this or the app refuses to boot.
SECRET_KEY=replace-this-with-a-secure-random-string-of-32-chars

# AI — defaults to the `echo` provider (no API key, no network required)
AI_PROVIDER=echo
AI_MODEL=echo-1
AI_PROMPT_VERSION=v1
AI_REQUEST_TIMEOUT=30        # per provider call/token, seconds
# OPENAI_API_KEY=sk-...      # only needed if you wire a real provider (see docs/architecture.md)

# AI response cache (in-process exact-match)
CACHE_TTL=300
CACHE_MAX_SIZE=1024

# Server bind is owned by the ASGI server, not app config:
#   local dev  -> `make dev` (uvicorn --host 0.0.0.0 --port 8000)
#   container  -> gunicorn.conf.py reads $PORT (default 8000) and $WEB_CONCURRENCY (workers)
